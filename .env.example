# =============================================================================
# EcoFibre Sync — Variables d'Environnement (.env.example)
# =============================================================================
# Copiez ce fichier en .env et remplissez les valeurs.
#   cp .env.example .env
#
# ⚠️  Ne commitez JAMAIS le fichier .env dans Git !
# =============================================================================

# --- PostgreSQL (doit correspondre au docker-compose.yml) ---
POSTGRES_USER=ecofibre
POSTGRES_PASSWORD=ecofibre_dev
POSTGRES_DB=ecofibre_sync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecofibre:ecofibre_dev@localhost:5432/ecofibre_sync

# --- Redis (doit correspondre au docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OpenAI (ou autre provider LLM) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# --- Langfuse (observabilité LLM) ---
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
